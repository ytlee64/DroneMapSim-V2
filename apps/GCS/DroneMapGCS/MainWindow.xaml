<Window x:Class="DroneMapGCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DroneMapGCS"
        Title="DroneMapGCS - Aerial Reconnaissance Viewer" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainWindowVM />
    </Window.DataContext>
<Grid Margin="{StaticResource ControlMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 헤더 정보 바 -->
            <RowDefinition Height="*"/>
            <!-- 메인 컨텐츠 영역 (좌: FPV / 우: 맵) -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 상태바 -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. 상단 헤더 바 (Style.xaml의 CardBorder 스타일 적용)     -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,6">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="FPV Live Stream" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>

                    <!-- 실시간 드론 비행 상태 출력 -->
                    <TextBlock Text="비행 계측: " Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TelemetryText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="4,0,20,0" VerticalAlignment="Center"/>

                    <!-- 사진 찍힌 위치 출력 -->
                    <TextBlock Text="{Binding LastCapturePosText}" Foreground="{StaticResource Foreground}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="수집: " Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCaptureCount, StringFormat='{}{0} 장'}" FontWeight="Bold" Margin="4,0,12,0" VerticalAlignment="Center"/>
                    <Button Content="리셋" Command="{Binding ResetCounterCommand}" Padding="10,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. 메인 2분할 뷰 영역 (좌측 절반: 영상 / 우측 절반: 맵 영역) -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <!-- 좌측 50%: 실시간 FPV 영상 -->
                <ColumnDefinition Width="6"/>
                <!-- 중앙 구분 여백 -->
                <ColumnDefinition Width="2*"/>
                <!-- 우측 50%: 2.3km 격자 오소모자이크 맵 자리 -->
            </Grid.ColumnDefinitions>

            <!-- [좌측 절반] FPV 카메라 영상 뷰어 -->
            <GroupBox Grid.Column="0" Header="실시간 정찰 영상 (FPV)">
                <Grid Background="{StaticResource Surface}" Margin="20">
                    <!-- 대기 안내 문구 -->
                    <TextBlock Text="언리얼 엔진 캡처 대기 중..." 
                               Foreground="{StaticResource Muted}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentFrame}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 640x512 고품질 영상 렌더링 (비율 유지 확대) -->
                    <Image Source="{Binding CurrentFrame}" 
                           Stretch="Uniform" 
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </GroupBox>

            <!-- [우측 절반] 향후 들어갈 전체 격자 지도(Grid Map) 영역 -->
            <GroupBox Grid.Column="2" Header="DroneMapSim Manual &amp; Mission Controller">
                <Grid ClipToBounds="True" Margin="20">

                    <!-- 2. 실시간 궤적 및 항법 캔버스 -->
                <Canvas x:Name="MapCanvas" SizeChanged="MapCanvas_SizeChanged">
                    <!-- 사각형 웨이포인트 경로선 -->
                    <Polygon Points="{Binding WaypointGuidePoints}" 
                     Stroke="#38BDF8" StrokeThickness="2" StrokeDashArray="4 2"/>

                    <!-- 실시간 비행 궤적선 -->
                    <Path Data="{Binding TrajectoryGeometry}" 
          Stroke="#00FFCC" StrokeThickness="2.5" 
          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Panel.ZIndex="5"/>


                        <!-- 드론 위치 마커 (중심 정렬) -->
                    <Ellipse Canvas.Left="{Binding MarkerLeft}" Panel.ZIndex="5" Canvas.Top="{Binding MarkerTop}"
                     Width="14" Height="14" Fill="#FF3B30" Stroke="#FFFFFF" StrokeThickness="2"/>

                    <!-- 기수 방향(Heading) 선 -->
                    <Line X1="{Binding HeadingX1}" Y1="{Binding HeadingY1}"
                  X2="{Binding HeadingX2}" Y2="{Binding HeadingY2}"
                  Stroke="#FACC15" StrokeThickness="2.5"/>
                </Canvas>

                

                <!-- 4. 우측 상단 궤적 리셋 버튼 (RelayCommand 바인딩) -->
                <Button Content="궤적 리셋" Command="{Binding ClearTrajectoryCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                    Padding="10,4" Background="#27272A" Foreground="#E4E4E7" 
                    BorderBrush="#52525B" BorderThickness="1" Cursor="Hand"/>
            </Grid>
        </GroupBox>

        </Grid>

        <!-- ========================================================= -->
        <!-- 3. 하단 상태 표시줄                                       -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Margin="0,4,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}"/>
        </Border>
    </Grid>
</Window>
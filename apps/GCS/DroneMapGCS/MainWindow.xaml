<Window x:Class="DroneMapGCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DroneMapGCS"
        Title="DroneMapGCS - Tactical Aerial Reconnaissance Station" 
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <local:MainWindowVM />
    </Window.DataContext>

    <Grid Margin="{StaticResource ControlMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. 상단 원격계측 헤더 바 -->
            <RowDefinition Height="*"/>
            <!-- 2. 메인 뷰 (좌: FPV+조종 / 우: 전술 지도) -->
            <RowDefinition Height="Auto"/>
            <!-- 3. 하단 상태 바 -->
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. 상단 원격계측 및 데이터셋 수집 현황 바                 -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,6" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="FPV LIVE STREAM" FontWeight="Bold" Margin="0,0,16,0"/>
                    <Border Background="{StaticResource SurfaceAlt}" CornerRadius="3" Padding="6,2" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="비행 계측: " Foreground="{StaticResource Muted}" FontSize="12"/>
                            <TextBlock Text="{Binding TelemetryText}" Foreground="{StaticResource AccentHover}" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding LastCapturePosText}" Foreground="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="수집된 데이터셋: " Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock Text="{Binding TotalCaptureCount, StringFormat='{}{0} 장'}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Margin="4,0,16,0"/>
                    <Button Content="리셋" Command="{Binding ResetCounterCommand}" Padding="12,3" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- 2. 메인 뷰 (좌: FPV + 컨트롤 패널 / 우: 전술 지도)       -->
        <!-- ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- [좌측 절반] FPV 영상(위) + FlightControlPanel(아래) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="실시간 정찰 영상 (FPV)" Margin="0,0,0,6">
                    <Grid Background="{StaticResource SurfaceAlt}">
                        <TextBlock Text="언리얼 엔진 영상 스트림 대기 중..." 
                                   Foreground="{StaticResource Muted}" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentFrame}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding CurrentFrame}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </GroupBox>

                <!-- ⭐️ [UserControl 1] 조종 패널 -->
                <local:FlightControlPanel Grid.Row="1"/>
            </Grid>

            <!-- ⭐️ [UserControl 2] 우측 전술 지도 (DataContext = Map) -->
            <local:TacticalMap Grid.Column="2" DataContext="{Binding Map}"/>
        </Grid>

        <!-- ========================================================= -->
        <!-- 3. 하단 상태 표시줄                                       -->
        <!-- ========================================================= -->
        <Border Grid.Row="2" Margin="0,4,0,0" Padding="4,2">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
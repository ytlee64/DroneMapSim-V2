<Window x:Class="PacketUtil.DlgWord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PacketUtil"
        mc:Ignorable="d"
        Title="Word"  Height="Auto" Width="600"   WindowStartupLocation="CenterScreen"
        SizeToContent="Height">
  
    <StackPanel Margin="10">
        <Label Content="{Binding WordItem.Name}" FontSize="20" Margin="20,0,20,0"/>
        <DataGrid  Name="BitList" ItemsSource="{Binding BitItems}" Margin="10,10,10,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Bit" Binding="{Binding Path=Id}" Width="*"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Path=Name}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Path=Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Margin="100,0,0,0" HorizontalAlignment="Right" >
            <Button Name="Ok" Margin="10" Width="100" Click="Ok_Click" >Ok</Button>
        </StackPanel>
    </StackPanel>
</Window>

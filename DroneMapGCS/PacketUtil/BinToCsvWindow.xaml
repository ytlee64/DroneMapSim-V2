<Window x:Class="PacketUtil.BinToCsvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PacketUtil"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="BinToCsv" Width="800" Height="800"
        Background="AliceBlue">
    
    <StackPanel>
        <Grid>
            <TextBox Name="FolderPathTextBox" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="300" Margin="10,10,0,0" />
        <!-- Button to trigger folder selection -->
            <Button Content="Select Folder" HorizontalAlignment="Left" VerticalAlignment="Top"  Height="30" Margin="320,10,0,0" Click="SelectFolder_Click"/>
        </Grid>
        <DataGrid Margin="10" ItemsSource="{Binding Packets}" AutoGenerateColumns="False"  Height="650">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding PacketStatus}" Width="7*"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Window>
